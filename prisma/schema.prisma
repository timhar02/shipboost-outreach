generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceKind {
  PRODUCT_HUNT
  PEERPUSH
  PEERLIST
  UNEED
  FOUNDRLIST
  SCROLLLAUNCH
  HACKER_NEWS
  BETALIST
  STARTUPBASE
  PITCHWALL
  LAUNCHING_NEXT
  SAASHUB
}

enum LaunchProcessStatus {
  PENDING
  DRAFT_CREATED
  SKIPPED_DEDUP
  SKIPPED_NO_EMAIL
  SKIPPED_ERROR
}

enum DraftStatus {
  PENDING_REVIEW
  SENT
  SKIPPED
  FAILED
  BOUNCED
}

enum EventKind {
  OPEN
  REPLY
  FOLLOWUP_SENT
  BOUNCE
}

enum Direction {
  OUT
  IN
}

enum EmailProvider {
  GMAIL
}

enum DiscoveredFrom {
  CONTACT_PAGE
  ABOUT_PAGE
  HOMEPAGE_FOOTER
  MAILTO_LINK
  META_TAG
}

model Source {
  id       String     @id @default(cuid())
  kind     SourceKind @unique
  name     String
  enabled  Boolean    @default(true)
  launches Launch[]
}

model Launch {
  id          String    @id @default(cuid())
  source      Source    @relation(fields: [sourceId], references: [id])
  sourceId    String
  externalId  String
  name        String
  tagline     String?
  url         String
  launchedAt  DateTime
  raw         Json
  fetchedAt   DateTime  @default(now())
  // Set the first time we run processLaunch on this row. Pending queue picks
  // rows where processedAt IS NULL so we never retry the same dead-end forever.
  processedAt DateTime?
  processStatus LaunchProcessStatus @default(PENDING)
  processError  String?
  contact     Contact?

  @@unique([sourceId, externalId])
  @@index([processStatus])
}

model Contact {
  id             String          @id @default(cuid())
  email          String          @unique
  domain         String          @unique
  name           String?
  launch         Launch          @relation(fields: [launchId], references: [id])
  launchId       String          @unique
  discoveredFrom DiscoveredFrom
  drafts         OutreachDraft[]
  createdAt      DateTime        @default(now())
  // The $9 Premium Launch code (and its "good through" display date) stamped at
  // first-touch and reused across every follow-up to this contact.
  discountCode     String?
  discountDeadline DateTime?
  suppressedAt     DateTime?
  suppressionReason String?
}

model OutreachDraft {
  id            String          @id @default(cuid())
  contact       Contact         @relation(fields: [contactId], references: [id])
  contactId     String
  parentDraft   OutreachDraft?  @relation("FollowUp", fields: [parentDraftId], references: [id])
  parentDraftId String?
  followUps     OutreachDraft[] @relation("FollowUp")
  templateKey   String
  subject       String
  body          String
  bodyText      String
  status        DraftStatus     @default(PENDING_REVIEW)
  createdAt     DateTime        @default(now())
  sentAt        DateTime?
  events        OutreachEvent[]
  messages      EmailMessage[]
}

model OutreachEvent {
  id        String        @id @default(cuid())
  draft     OutreachDraft @relation(fields: [draftId], references: [id])
  draftId   String
  kind      EventKind
  payload   Json
  createdAt DateTime      @default(now())
}

model EmailMessage {
  id                String        @id @default(cuid())
  draft             OutreachDraft @relation(fields: [draftId], references: [id])
  draftId           String
  providerMessageId String        @unique
  providerThreadId  String?
  direction         Direction
  subject           String
  snippet           String
  headers           Json
  receivedAt        DateTime      @default(now())

  @@index([providerThreadId])
}

model EmailCredential {
  id           String   @id @default(cuid())
  provider     EmailProvider @default(GMAIL)
  accountEmail String
  refreshToken String
  scope        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([provider, accountEmail])
}

model AutoSendState {
  id            String   @id
  lastSentAt    DateTime?
  nextAllowedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum ConversionType {
  PREMIUM_LAUNCH
  AD
}

enum ConversionMatchStatus {
  MATCHED_DOMAIN
  MATCHED_EMAIL
  POSSIBLE
  CONFIRMED
  REJECTED
  ORGANIC
}

/// A paid conversion pulled from the main ShipBoost app (separate DB) and
/// attributed back to a cold-email contact. `id` is the source row id from
/// my-app (Submission.id or SponsorPlacement.id), so re-syncs upsert cleanly.
model Conversion {
  id                 String                @id
  type               ConversionType
  websiteDomain      String
  founderEmail       String?
  productName        String
  amountCents        Int
  currency           String                @default("USD")
  paidAt             DateTime
  matchStatus        ConversionMatchStatus @default(ORGANIC)
  matchedContactId   String?
  matchedDraftId     String?
  matchedTemplateKey String?
  matchConfidence    Float?
  pulledAt           DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([type])
  @@index([matchStatus])
  @@index([matchedTemplateKey])
  @@index([websiteDomain])
  @@index([paidAt])
}

/// Singleton cursor row for the hourly conversions pull.
model ConversionSyncState {
  id         String    @id
  lastPaidAt DateTime?
  lastRunAt  DateTime?
  updatedAt  DateTime  @updatedAt
}
